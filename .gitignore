# Track only the distributable mod, its source, and publication/build files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD-PARTY-NOTICES.md
!/Build.ps1
!/CrimsonSOS2/
!/MOD_PROJECTS/
!/Tools/
!/.vscode/

# Reassembled package is a generated junction; projects own the editable files.
/CrimsonSOS2

# Never publish saves, local profiles, credentials, or transient build output.
**/bin/
**/obj/
**/.vs/
**/__pycache__/
*.pdb
*.rws
*.rws.bak
*.log
*.tmp
*.bak
*.zip
.env
.env.*
*.pfx
*.p12
*.key
