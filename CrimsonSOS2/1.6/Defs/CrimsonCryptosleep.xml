<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Native SOS2 ship casket behavior and fixed recipe, with dedicated Crimson art and furniture standards. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Crimson_ShipCryptosleepCasket</defName>
    <label>심홍 함선 동면관</label>
    <description>검은 각면 외장과 짙은 관측창으로 보호되는 1인용 함선 동면관입니다. 탑승자는 동면 상태로 보존되며, 전원이 공급되면 비어 있어도 심홍색 표시등과 약한 주변 조명이 켜집니다. 소비전력은 250W이며 정전 시 표시등이 꺼집니다. SOS2 함선 동면관과 같은 자동 개방 및 비상 탈출 기능을 갖춥니다.</description>
    <thingClass>Building_CryptosleepCasket</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Crimson/Decor/Cryptosleep/CryptosleepStates</texPath>
      <graphicClass>CrimsonSOS2.CrimsonCryptosleepGraphic</graphicClass>
      <drawSize>(0.96,1.96)</drawSize>
      <shaderType>Cutout</shaderType>
      <allowFlip>false</allowFlip>
      <addTopAltitudeBias>true</addTopAltitudeBias>
      <shadowData IsNull="True" />
    </graphicData>
    <uiIconPath>Crimson/Decor/Cryptosleep/CryptosleepStates</uiIconPath>
    <researchPrerequisites><li>ShipCryptosleep</li></researchPrerequisites>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <WorkToBuild>3200</WorkToBuild>
      <MaxHitPoints>1750</MaxHitPoints>
      <Beauty>10</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <tickerType>Normal</tickerType>
    <size>(1,2)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <designationCategory>Misc</designationCategory>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(1,0,0)</interactionCellOffset>
    <comps>
      <li Class="SaveOurShip2.CompProps_ShipCachePart" />
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>250</basePowerConsumption><transmitsPower>true</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>1.6</glowRadius><glowColor>(120,20,16,0)</glowColor></li>
      <li Class="CompProperties_Explosive"><explosiveRadius>2.66</explosiveRadius><explosiveDamageType>Flame</explosiveDamageType></li>
      <li Class="SaveOurShip2.CompProps_CryptoLaunchable" />
      <li><compClass>CompQuality</compClass></li>
      <li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>250</originalMaxHitPoints><goldReference>true</goldReference></li>
    </comps>
    <building><isPlayerEjectable>true</isPlayerEjectable></building>
    <stuffCategories Inherit="False" />
    <costStuffCount>0</costStuffCount>
    <defaultStuff IsNull="True" />
    <costList><Steel>180</Steel><Uranium>5</Uranium><ComponentIndustrial>4</ComponentIndustrial><ComponentSpacer>1</ComponentSpacer></costList>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <placeWorkers><li>PlaceWorker_PreventInteractionSpotOverlap</li></placeWorkers>
    <inspectorTabs><li>ITab_ContentsCasket</li></inspectorTabs>
    <uiOrder>1061</uiOrder>
    <designatorDropdown IsNull="True" />
  </ThingDef>
</Defs>
