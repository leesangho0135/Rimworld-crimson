<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>Crimson_Echo</defName>
    <label>잔향</label>
    <thingClass>SaveOurShip2.MechaniteFire</thingClass>
    <category>Attachment</category>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Crimson/Weapons/Echo</texPath>
      <graphicClass>Graphic_Flicker</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <altitudeLayer>PawnState</altitudeLayer>
    <useHitPoints>false</useHitPoints>
  </ThingDef>
  <!-- Same projectile class and flight contract as the installed MechaniteSpark.
       A distinct Def carries the Echo family through its native landing code. -->
  <ThingDef>
    <defName>Crimson_EchoSpark</defName>
    <label>잔향</label>
    <category>Projectile</category>
    <thingClass>SaveOurShip2.Projectile_MechaniteSpark</thingClass>
    <graphicData>
      <texPath>Crimson/Weapons/Echo/EchoA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <neverMultiSelect>true</neverMultiSelect>
    <projectile>
      <alwaysFreeIntercept>true</alwaysFreeIntercept>
      <speed>1.5</speed>
    </projectile>
  </ThingDef>
  <DamageDef>
    <defName>Crimson_EchoBurst</defName>
    <label>잔향</label>
    <workerClass>SaveOurShip2.DamageWorker_Mechanite</workerClass>
    <externalViolence>true</externalViolence>
    <isExplosive>true</isExplosive>
    <deathMessage>{0} has died in an explosion.</deathMessage>
    <hediff>Shredded</hediff>
    <hediffSolid>Crack</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Blunt</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <minDamageToFragment>15</minDamageToFragment>
    <defaultDamage>135</defaultDamage>
    <defaultStoppingPower>0.5</defaultStoppingPower>
    <defaultArmorPenetration>0.10</defaultArmorPenetration>
    <buildingDamageFactor>1</buildingDamageFactor>
    <plantDamageFactor>4</plantDamageFactor>
    <explosionAffectOutsidePartsOnly>false</explosionAffectOutsidePartsOnly>
    <explosionHeatEnergyPerCell>5</explosionHeatEnergyPerCell>
    <explosionCellMote>Crimson_EchoBlastMote</explosionCellMote>
    <explosionColorCenter>(0.6, 0.6, 0.6)</explosionColorCenter>
    <explosionColorEdge>(0.2, 0.2, 0.2)</explosionColorEdge>
    <soundExplosion>DispensePaste</soundExplosion>
    <combatLogRules>Damage_Bomb</combatLogRules>
  </DamageDef>
  <WorkGiverDef>
    <defName>Crimson_FightEcho</defName>
    <label>잔향 제거</label>
    <giverClass>SaveOurShip2.WorkGiver_FightMechanites</giverClass>
    <workType>Firefighter</workType>
    <emergency>true</emergency>
    <verb>scraping</verb>
    <gerund>scraping</gerund>
    <canBeDoneWhileDrafted>true</canBeDoneWhileDrafted>
    <autoTakeablePriorityDrafted>20</autoTakeablePriorityDrafted>
    <forceFleck>FeedbackExtinguish</forceFleck>
  </WorkGiverDef>
  <ThingDef ParentName="MoteBase">
    <defName>Crimson_EchoBlastMote</defName>
    <graphicData>
      <texPath>Things/Mote/MechaniteBlast</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <color>(255,16,32)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <solidTime>0</solidTime>
      <fadeOutTime>0.2</fadeOutTime>
    </mote>
  </ThingDef>
</Defs>
