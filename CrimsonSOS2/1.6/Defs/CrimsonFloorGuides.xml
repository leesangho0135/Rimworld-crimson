<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DesignatorDropdownGroupDef><defName>Crimson_FloorGuides</defName></DesignatorDropdownGroupDef>
  <ThingDef Name="Crimson_FloorGuideBase" ParentName="Crimson_DeckLightBase" Abstract="True">
    <thingClass>Building</thingClass>
    <rotatable>true</rotatable>
    <blockLight>false</blockLight>
    <graphicData>
      <graphicClass>CrimsonSOS2.CrimsonFloorGuideGraphic</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>(0.60,0.33)</drawSize>
      <shadowData IsNull="True" />
    </graphicData>
    <designatorDropdown>Crimson_FloorGuides</designatorDropdown>
    <uiOrder>999</uiOrder>
    <statBases><WorkToBuild>60</WorkToBuild><Beauty>1</Beauty></statBases>
    <costList><Steel>2</Steel></costList>
    <comps Inherit="False">
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>10</basePowerConsumption><transmitsPower>false</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>1.6</glowRadius><glowColor>(144,24,16,0)</glowColor></li>
    </comps>
    <placeWorkers Inherit="False"><li>CrimsonSOS2.CrimsonFloorGuidePlaceWorker</li></placeWorkers>
  </ThingDef>
  <ThingDef ParentName="Crimson_FloorGuideBase">
    <defName>Crimson_FloorBeacon</defName>
    <label>바닥 유도 표식</label>
    <description>교차로나 방 입구의 모노리스 갑판 위에 덧놓는 작은 마름모 표식입니다. 전력 10W를 사용하며 전원이 공급되면 중앙의 짧은 진홍색 홈이 빛나고 가까운 바닥을 은은하게 밝힙니다. 통행을 막지 않습니다.</description>
    <graphicData><texPath>Crimson/Decor/Guides/FloorBeaconStates</texPath></graphicData>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
      <costList Inherit="False"><Steel>2</Steel></costList>
      <statBases><Beauty>20</Beauty><MarketValue>200.1944</MarketValue><MaxHitPoints>560</MaxHitPoints><Flammability>0</Flammability></statBases>
      <comps><li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>80</originalMaxHitPoints></li></comps>
    <designationCategory>Furniture</designationCategory>
    <designatorDropdown>Crimson_Lighting</designatorDropdown>
    <uiOrder>1063</uiOrder>
  </ThingDef>
  <ThingDef ParentName="Crimson_FloorGuideBase">
    <defName>Crimson_ThresholdGuide</defName>
    <label>문턱 유도등</label>
    <description>모노리스 갑판 위 문칸의 앞 가장자리에 덧놓는 얇은 진홍색 조명 레일입니다. 기존 문과 갑판을 유지하며 문이 열리고 닫혀도 통행을 막지 않습니다. 회전으로 문턱 방향을 맞춥니다. 전력 10W를 사용하며 전원이 공급되면 항상 빛나고 가까운 바닥을 은은하게 밝힙니다.</description>
    <graphicData>
      <texPath>Crimson/Decor/Guides/ThresholdGuideStates</texPath>
      <drawSize>(0.98,0.10)</drawSize>
      <drawOffsetNorth>(0,0,-0.56)</drawOffsetNorth>
      <drawOffsetEast>(-0.56,0,0)</drawOffsetEast>
      <drawOffsetSouth>(0,0,0.56)</drawOffsetSouth>
      <drawOffsetWest>(0.56,0,0)</drawOffsetWest>
    </graphicData>
    <placeWorkers Inherit="False"><li>CrimsonSOS2.CrimsonThresholdGuidePlaceWorker</li></placeWorkers>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
      <costList Inherit="False"><Steel>2</Steel></costList>
      <statBases><Beauty>20</Beauty><MarketValue>200.1944</MarketValue><MaxHitPoints>560</MaxHitPoints><Flammability>0</Flammability></statBases>
      <comps><li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>80</originalMaxHitPoints></li></comps>
    <designationCategory>Furniture</designationCategory>
    <designatorDropdown>Crimson_Lighting</designatorDropdown>
    <uiOrder>1064</uiOrder>
  </ThingDef>
</Defs>
