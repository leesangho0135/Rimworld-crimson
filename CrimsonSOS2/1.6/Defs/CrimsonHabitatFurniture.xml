  <ThingDef ParentName="Crimson_HabitatBedBase">
    <defName>Crimson_CrewBed</defName>
    <label>심홍 승무원침대</label>
    <description>함선 거주 구역을 위한 1인용 침대입니다. 전원 공급 시 편안함이 50% 향상되며 기본 자연 치유량은 하루 6입니다. 편안함은 전설 규격을 기준으로 연결된 협탁·옷장의 보조 효과에 따라 달라집니다. 250W 전력은 표시등과 약한 주변 조명, 편안함 보조 장치에 사용하며 정전 중에도 침대에서 잘 수 있습니다.</description>
    <graphicData><texPath>Crimson/Decor/Habitat/SingleBedStates</texPath><drawSize>(1,2)</drawSize></graphicData>
    <statBases><BedRestEffectiveness>1.2</BedRestEffectiveness><Comfort>1.6</Comfort><Beauty>120</Beauty><MarketValue>9205.832</MarketValue><MaxHitPoints>1260</MaxHitPoints><Flammability>0</Flammability></statBases>
    <costList Inherit="False"><Steel>60</Steel><Cloth>30</Cloth><ComponentIndustrial>2</ComponentIndustrial></costList>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>250</basePowerConsumption><transmitsPower>false</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>1.6</glowRadius><glowColor>(120,20,16,0)</glowColor></li>
      <li Class="CompProperties_AffectedByFacilities"><linkableFacilities><li>Crimson_BedsideTable</li><li>Crimson_Wardrobe</li></linkableFacilities></li>
      <li Class="CrimsonSOS2.CompProperties_CrimsonPoweredComfort" />
    <li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><facilityComfortIsFinal>true</facilityComfortIsFinal><originalMaxHitPoints>180</originalMaxHitPoints></li></comps>
    <uiOrder>1000</uiOrder>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
    <designationCategory>Furniture</designationCategory>
    <designatorDropdown>Crimson_BedroomFurniture</designatorDropdown>
  </ThingDef>

