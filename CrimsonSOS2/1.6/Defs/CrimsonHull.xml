  <ThingDef ParentName="BuildingBase">
    <defName>Crimson_Deck</defName>
    <label>모노리스 갑판</label>
    <designatorDropdown>Crimson_Decks</designatorDropdown>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshOnly</drawerType>
    <category>Building</category>
    <graphicData>
      <texPath>Crimson/Hull/DeckSeamless</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <seeThroughFog>true</seeThroughFog>
    <uiIconPath>Crimson/Hull/DeckSeamless</uiIconPath>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <shipPart>true</shipPart>
      <blueprintGraphicData>
        <texPath>Things/Building/Ship/HullPlate</texPath>
      </blueprintGraphicData>
    </building>
    <coversFloor>false</coversFloor>
    <altitudeLayer>LowPlant</altitudeLayer>
    <passability>Standable</passability>
    <drawStyleCategory>Foundations</drawStyleCategory>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>0.0</Flammability>
      <Beauty>2</Beauty>
      <Cleanliness>0.3</Cleanliness>
    </statBases>
    <description>Spaceworthy hull plating designed by an archotech.</description>
    <costList>
      <Steel>1</Steel>
      <Plasteel>1</Plasteel>
      <Gold>1</Gold>
    </costList>
    <comps>
      <li Class="SaveOurShip2.CompProps_ShipCachePart">
        <isPlating>true</isPlating>
        <hermetic>true</hermetic>
        <archotech>true</archotech>
        <roof>true</roof>
      </li>
      <li Class="SaveOurShip2.CompProps_ResearchUnlock">
        <unlock>ArchotechUplink</unlock>
      </li>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
    <placeWorkers>
      <li>SaveOurShip2.PlaceWorker_ShipPlating</li>
    </placeWorkers>
    <rotatable>false</rotatable>
    <tickerType>Never</tickerType>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <terrainAffordanceNeeded IsNull="True" />
    <constructEffect>ConstructMetal</constructEffect>
    <designationHotKey>Misc1</designationHotKey>
    <fillPercent>0.0</fillPercent>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <designationCategory>Crimson_CS</designationCategory>
    <modExtensions>
      <li Class="CrimsonSOS2.CrimsonHullExtension">
        <archotechDeck>true</archotechDeck>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>Crimson_Airlock</defName>
    <label>모노리스 에어록</label>
    <designatorDropdown>Crimson_Airlocks</designatorDropdown>
    <description>Allows access to a ship or divides rooms inside it. Low-energy plasma barriers prevent gases from escaping. In Odyssey space, partially allows vacuum in when open, so having double airlocks on ship exits is recommended.</description>
    <category>Building</category>
    <thingClass>CrimsonSOS2.CrimsonAirlock</thingClass>
    <designationCategory>Crimson_CS</designationCategory>
    <altitudeLayer>DoorMoveable</altitudeLayer>
    <fillPercent>1</fillPercent>
    <useHitPoints>true</useHitPoints>
    <graphicData>
      <texPath>Crimson/Hull/AirlockMover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <!--  no damage marks because they don't move with the door
        <rect>(0,0.12,1,0.76)</rect>-->
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Crimson/Hull/AirlockIcon</uiIconPath>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Plasteel>15</Plasteel>
      <Gold>25</Gold>
    </costList>
    <comps>
      <li Class="SaveOurShip2.CompProps_ShipCachePart">
        <isHull>true</isHull>
        <isPlating>true</isPlating>
        <hermetic>true</hermetic>
        <archotech>true</archotech>
        <roof>true</roof>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>20</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Forbiddable" />
      <li Class="SaveOurShip2.CompProps_ShipHeat">
        <compClass>SaveOurShip2.CompShipHeat</compClass>
      </li>
      <li Class="SaveOurShip2.CompProps_ResearchUnlock">
        <unlock>ArchotechUplink</unlock>
      </li>
      <li>
        <compClass>CompColorable</compClass>
      </li>
      <li Class="CrimsonSOS2.CrimsonUnfoldProperties">
        <extendRate>0.005</extendRate>
        <retractRate>0.005</retractRate>
        <retractTime>240</retractTime>
        <extendDirection>(0,0,-1)</extendDirection>
        <startOffset>0.5</startOffset>
        <length>3.0</length>
        <width>3.0</width>
        <graphicPath>Crimson/Hull/DockTube</graphicPath>
        <graphicPathAlt>Crimson/Hull/DockTubeV</graphicPathAlt>
      </li>
      <li Class="DubsBadHygiene.CompProperties_Pipe" MayRequire="Dubwise.DubsBadHygiene"><mode>Sewage</mode></li>
    </comps>
    <designationHotKey>Misc2</designationHotKey>
    <placeWorkers>
      <li>SaveOurShip2.PlaceWorker_ShipHull</li>
    </placeWorkers>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
      <MaxHitPoints>3000</MaxHitPoints>
      <Flammability>0.0</Flammability>
    </statBases>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <holdsRoof>true</holdsRoof>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <drawerType>RealtimeOnly</drawerType>
    <building>
      <isAirtight>true</isAirtight>
      <shipPart>true</shipPart>
      <isInert>true</isInert>
      <canPlaceOverWall>true</canPlaceOverWall>
      <soundDoorOpenPowered>Door_OpenPowered</soundDoorOpenPowered>
      <soundDoorClosePowered>Door_ClosePowered</soundDoorClosePowered>
      <soundDoorOpenManual>Door_OpenManual</soundDoorOpenManual>
      <soundDoorCloseManual>Door_CloseManual</soundDoorCloseManual>
      <blueprintGraphicData>
        <texPath>Things/Building/Door/Door_Blueprint</texPath>
      </blueprintGraphicData>
      <blueprintClass>Blueprint_Door</blueprintClass>
      <roamerCanOpen>false</roamerCanOpen>
      <paintable>true</paintable>
    </building>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
  </ThingDef>
  <ThingDef ParentName="BuildingShipHullBase">
    <defName>Crimson_SolarGenerator</defName>
    <label>항성 집광판</label>
    <designatorDropdown>Crimson_SolarGenerators</designatorDropdown>
    <description>Uses photons to entangle itself with the star's photosphere, absorbing more energy than the sunlight alone would provide. Produces up to 1200W in space and 600W on planet surface. Does not work in the dark or under artificial light.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Crimson/Hull/HullWall_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
        <edgeTop>Damage/Edge</edgeTop>
        <edgeBot>Damage/Edge</edgeBot>
        <edgeLeft>Damage/Edge</edgeLeft>
        <edgeRight>Damage/Edge</edgeRight>
      </damageData>
    </graphicData>
    <uiIconPath>Crimson/Hull/SolarIcon</uiIconPath>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToBuild>8000</WorkToBuild>
      <MaxHitPoints>3600</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <selectable>true</selectable>
    <costList>
      <Steel>50</Steel>
      <Plasteel>25</Plasteel>
      <Gold>25</Gold>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <building>
      <shipPart>true</shipPart>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Wall_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
      <paintable>true</paintable>
      <supportsWallAttachments>true</supportsWallAttachments>
    </building>
    <comps>
      <li Class="SaveOurShip2.CompProps_ShipCachePart">
        <isHull>true</isHull>
        <hermetic>true</hermetic>
        <archotech>true</archotech>
        <roof>true</roof>
      </li>
      <li Class="SaveOurShip2.CompProps_PowerPlantSolarShip">
        <compClass>SaveOurShip2.CompPowerPlantSolarShip</compClass>
        <basePowerConsumption>-1</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <bonusPower>2</bonusPower>
      </li>
      <li Class="CrimsonSOS2.CrimsonUnfoldProperties">
        <extendRate>0.005</extendRate>
        <retractRate>0.0025</retractRate>
        <retractTime>750</retractTime>
        <extendDirection>(0,0,-1)</extendDirection>
        <startOffset>0.5</startOffset>
        <length>3.0</length>
        <graphicPath>Crimson/Hull/SolarExpand</graphicPath>
        <isSolar>true</isSolar>
      </li>
      <li Class="SaveOurShip2.CompProps_ShipHeat">
        <compClass>SaveOurShip2.CompShipHeat</compClass>
      </li>
      <li Class="SaveOurShip2.CompProps_ResearchUnlock">
        <unlock>ArchotechUplink</unlock>
      </li>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
    <placeWorkers>
      <li>SaveOurShip2.PlaceWorker_SolarShip</li>
    </placeWorkers>
    <designationCategory>Crimson_CS</designationCategory>
    <designationHotKey>Misc5</designationHotKey>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>
  <ThingDef ParentName="BuildingShipHullBase">
    <defName>Crimson_PassiveVent</defName>
    <label>평형 환기구</label>
    <designatorDropdown>Crimson_Vents</designatorDropdown>
    <description>A passive vent that equalizes temperature and gases between adjacent rooms. It uses the vanilla vent open/close control and does not actively heat or cool one side.</description>
    <thingClass>Building_Vent</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <graphicData>
      <texPath>Crimson/Hull/HullWall_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
