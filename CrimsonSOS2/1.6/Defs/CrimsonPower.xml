<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Crimson_AntimatterReactor</defName>
    <label>특이점 반응로</label>
    <designatorDropdown>Ship_Reactors</designatorDropdown>
    <description>특이 입자를 소모하여 250,000 W를 생산하는 3×3 반응로입니다. 함선 열망에 발생시키는 열은 0 Hu/s입니다. 원본 반물질 원자로의 연료 및 손상 시 폭발 동작을 유지합니다.</description>
    <thingClass>CrimsonSOS2.CrimsonPowerBuilding</thingClass>
    <graphicData>
      <texPath>Crimson/Power/Reactor/Inactive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>3000</MaxHitPoints>
      <WorkToBuild>25000</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <size>(3,3)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <Plasteel>225</Plasteel>
      <Silver>150</Silver>
      <Gold>150</Gold>
      <ComponentSpacer>15</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-250000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <soundAmbientProducingPower>ShipReactor_Ambience</soundAmbientProducingPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <fuelConsumptionRate>5</fuelConsumptionRate>
        <fuelCapacity>500</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>ArchotechExoticParticles</li>
          </thingDefs>
        </fuelFilter>
        <autoRefuelPercent>0.9</autoRefuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>12</glowRadius>
        <glowColor>(120,20,20,0)</glowColor>
      </li>
      <li Class="SaveOurShip2.CompProps_ShipHeat">
        <compClass>SaveOurShip2.CompShipHeatSource</compClass>
        <heatPerSecond>0</heatPerSecond>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>48</explosiveRadius>
        <explosiveDamageType>ShipTorpedoBombSuper</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
        <postExplosionSpawnThingDef>Filth_SpaceReactorAsh</postExplosionSpawnThingDef>
        <postExplosionSpawnThingCount>1000</postExplosionSpawnThingCount>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Crimson_CS</designationCategory>
    <designationHotKey>Misc4</designationHotKey>
    <constructEffect>ConstructMetal</constructEffect>
    <placeWorkers>
      <li>SaveOurShip2.PlaceWorker_OnShipHull</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ArchotechReactor</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    <modExtensions>
      <li Class="Vehicles.CustomCostDefModExtension">
        <cost>10000</cost>
      </li>
      <li Class="CrimsonSOS2.CrimsonPowerArt">
        <activePath>Crimson/Power/Reactor/Active</activePath>
        <inactivePath>Crimson/Power/Reactor/Inactive</inactivePath>
        <drawSize>(3,3)</drawSize>
        <directional>false</directional>
        <engine>false</engine>
        <battery>false</battery>
      </li>
    </modExtensions>
    <drawerType>RealtimeOnly</drawerType>
  </ThingDef>
  <ThingDef ParentName="ShipHeatsinkBase">
    <defName>Crimson_AntiEntropyHeatbank</defName>
    <designationCategory>Crimson_CS</designationCategory>
    <label>엔트로피 역전기</label>
    <description>50,000 Hu를 저장하는 3×3 열저장고입니다. 원본의 열·전력 조건이 충족되면 2초마다 최대 500 Hu(평균 250 Hu/s)를 처리하며, 회복 계수는 0.2입니다. 저장률에 따른 이미지 변경 없이 고정 외형을 사용합니다.</description>
    <size>(3,3)</size>
    <graphicData>
      <texPath>Crimson/Power/Heatbank/Fixed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <building />
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <WorkToBuild>3500</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <costList>
      <Steel>15</Steel>
      <Plasteel>25</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
      <ArchotechExoticParticles>2</ArchotechExoticParticles>
    </costList>
    <comps>
      <li Class="SaveOurShip2.CompProps_ShipHeat">
        <compClass>SaveOurShip2.CompShipHeatSink</compClass>
        <heatCapacity>50000</heatCapacity>
        <heatVent>500</heatVent>
        <threat>3</threat>
        <antiEntropic>true</antiEntropic>
        <antiEntropicRecoveryRate>0.2</antiEntropicRecoveryRate>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTransmitter</compClass>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <researchPrerequisites>
      <li>ArchotechHeatsink</li>
    </researchPrerequisites>
  </ThingDef>
  <ThingDef ParentName="BuildingShipBase">
    <defName>Crimson_NuclearEngine</defName>
    <label>홍련 핵추진기</label>
    <designatorDropdown>Ship_Engines</designatorDropdown>
    <thingClass>CrimsonSOS2.CrimsonPowerBuilding</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Crimson/Power/Nuclear/Inactive</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5,7)</drawSize>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <researchPrerequisites>
      <li>ShipEngine</li>
      <li>ShipReactor</li>
    </researchPrerequisites>
    <statBases>
      <WorkToBuild>80000</WorkToBuild>
      <MaxHitPoints>50000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <tickerType>Normal</tickerType>
    <description>홍련 계열의 핵추진기입니다.\n\n추력: 60,000\n연료 소모: 15/s\n연료 저장량: 40,000\n소비 전력: 2,000 W\n후방 배기 위험 구역: 폭 5 × 길이 9칸</description>
    <size>(5,7)</size>
    <receivesSignals>true</receivesSignals>
    <designationCategory>Crimson_CS</designationCategory>
    <comps>
      <li Class="SaveOurShip2.CompProps_ShipCachePart">
        <hermetic>true</hermetic>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>2000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>40000</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <fuelFilter>
          <thingDefs>
            <li>ShuttleFuelPods</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>0.9</autoRefuelPercent>
        <showFuelGizmo>false</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <drawFuelGaugeInMap>false</drawFuelGaugeInMap>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CrimsonSOS2.CompProperties_CrimsonEngine">
        <!--graphicData>
					<texPath>Things/Building/Ship/NuclearEngineTrail</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>(7,26.5)</drawSize>
				</graphicData-->
        <thrust>120</thrust>
        <fuelUse>15</fuelUse>
        <takeOff>true</takeOff>
        <killZoneLength>9</killZoneLength>
        <killZoneWidth>5</killZoneWidth>
        <soundWorking>ShipEngineFuel</soundWorking>
        <flamePath>Crimson/Power/Nuclear/Flame</flamePath>
        <flameLayouts>
          <li>
            <drawSize>(2.5,7.47931034)</drawSize>
            <offset>(0,-6.09089655)</offset>
          </li>
          <li>
            <drawSize>(7.65280702,2.5579922)</drawSize>
            <offset>(-6.16723509,0)</offset>
          </li>
          <li>
            <drawSize>(2.15918624,6.45671141)</drawSize>
            <offset>(0,5.64095302)</offset>
          </li>
          <li>
            <drawSize>(7.08166998,2.36055666)</drawSize>
            <offset>(5.91593479,0)</offset>
          </li>
        </flameLayouts>
      </li>
    </comps>
    <placeWorkers>
      <li>SaveOurShip2.PlaceWorker_ShipEngine</li>
    </placeWorkers>
    <building>
      <isAirtight>true</isAirtight>
      <shipPart>true</shipPart>
    </building>
    <costList>
      <Steel>300</Steel>
      <Plasteel>120</Plasteel>
      <ComponentSpacer>8</ComponentSpacer>
    </costList>
    <designationHotKey>Misc5</designationHotKey>
    <modExtensions>
      <li Class="CrimsonSOS2.CrimsonPowerArt">
        <activePath>Crimson/Power/Nuclear/Active</activePath>
        <inactivePath>Crimson/Power/Nuclear/Inactive</inactivePath>
        <drawSize>(5,7)</drawSize>
        <directional>true</directional>
        <engine>true</engine>
        <battery>false</battery>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingShipBase">
    <defName>Crimson_JohnsonTanakaLarge</defName>
    <label>적색편이 추진기</label>
    <designatorDropdown>Ship_Engines_Interplanetary</designatorDropdown>
    <thingClass>CrimsonSOS2.CrimsonPowerBuilding</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Crimson/Power/Tanaka/Inactive</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5,7)</drawSize>
    </graphicData>
    <researchPrerequisites>
      <li>SoSJTDrive</li>
    </researchPrerequisites>
    <statBases>
      <WorkToBuild>120000</WorkToBuild>
      <MaxHitPoints>1200</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <tickerType>Normal</tickerType>
    <description>An advanced reactionless engine capable of interplanetary and interstellar travel.\n\nCannot be used inside a planet's atmosphere. This larger version, usually found on big warships, utilizes two manifolds in a more efficient configuration.\n\nJT mass limit: 30000\nThrust: 60000\n\n후방 배기 위험 구역: 폭 5 × 길이 9칸</description>
    <size>(5,7)</size>
    <receivesSignals>true</receivesSignals>
    <designationCategory>Crimson_CS</designationCategory>
    <comps>
      <li Class="SaveOurShip2.CompProps_ShipCachePart">
        <hermetic>true</hermetic>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>600</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CrimsonSOS2.CompProperties_CrimsonEngine">
        <!--graphicData>
					<texPath>Things/Building/Ship/Ship_Engine_Trail_Energy_Large</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>(11,26.5)</drawSize>
				</graphicData-->
        <energy>true</energy>
        <reactionless>true</reactionless>
        <reactionlessExhaustDamage>true</reactionlessExhaustDamage>
        <killZoneLength>9</killZoneLength>
        <killZoneWidth>5</killZoneWidth>
        <thrust>120</thrust>
      </li>
    </comps>
    <placeWorkers>
      <li>SaveOurShip2.PlaceWorker_ShipEngine</li>
    </placeWorkers>
    <building>
      <isAirtight>true</isAirtight>
      <shipPart>true</shipPart>
    </building>
    <costList>
      <Plasteel>500</Plasteel>
      <Uranium>300</Uranium>
      <ComponentSpacer>30</ComponentSpacer>
      <SoSEntanglementManifold>2</SoSEntanglementManifold>
    </costList>
    <designationHotKey>Misc5</designationHotKey>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <modExtensions>
      <li Class="CrimsonSOS2.CrimsonPowerArt">
        <activePath>Crimson/Power/Tanaka/Active</activePath>
        <inactivePath>Crimson/Power/Tanaka/Inactive</inactivePath>
        <drawSize>(5,7)</drawSize>
        <directional>true</directional>
        <engine>true</engine>
        <battery>false</battery>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>Crimson_Capacitor</defName>
    <label>심홍 축전지</label>
    <designatorDropdown>Ship_Capacitors</designatorDropdown>
    <thingClass>CrimsonSOS2.CrimsonPowerBuilding</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Crimson/Power/Battery/Body</texPath>
      <graphicClass>CrimsonSOS2.CrimsonCapacitorBodyGraphic</graphicClass>
      <drawSize>(4.83,3.74)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.40</fillPercent>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>200</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <description>250,000 Wd를 저장하는 심홍 축전지입니다. 충전할 때 실제 배분받은 잉여 전력만 소비합니다. 효율은 95%입니다.\n\n설치 크기는 모든 방향에서 3×3입니다. 하단 게이지는 현재 충전량을 나타냅니다.</description>
    <size>(3,3)</size>
    <costList>
      <Steel>50</Steel>
      <Plasteel>150</Plasteel>
      <ComponentSpacer>14</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CrimsonSOS2.CompProperties_CrimsonBattery">
        <storedEnergyMax>250000</storedEnergyMax>
        <efficiency>0.95</efficiency>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(120,16,16,0)</glowColor>
      </li>
      <li Class="RT_Fuse.CompProperties_RTFuse" MayRequire="ratys.rtfuse">
        <compClass>RT_Fuse.CompRTFuse</compClass>
        <surgeMitigation>10000</surgeMitigation>
        <breakdownOnTrip>false</breakdownOnTrip>
      </li>
    </comps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Crimson_CS</designationCategory>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <designationHotKey>Misc4</designationHotKey>
    <canOverlapZones>false</canOverlapZones>
    <researchPrerequisites>
      <li>ShipCapacitor</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="Vehicles.CustomCostDefModExtension">
        <cost>10000</cost>
      </li>
      <li Class="CrimsonSOS2.CrimsonPowerArt">
        <activePath>Crimson/Power/Battery/Body</activePath>
        <drawSize>(4.83,3.74)</drawSize>
        <directional>true</directional>
        <engine>false</engine>
        <battery>true</battery>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
