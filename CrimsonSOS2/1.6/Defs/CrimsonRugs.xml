<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DesignatorDropdownGroupDef><defName>Crimson_RugsA1</defName></DesignatorDropdownGroupDef>
  <ThingDef Name="Crimson_RugA1Base" ParentName="BuildingBase" Abstract="True">
