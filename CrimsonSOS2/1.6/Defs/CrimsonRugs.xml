    <size>(4,3)</size><graphicData><drawSize>(4,3)</drawSize></graphicData>
    <costList><Hyperweave>84</Hyperweave></costList>
    <statBases><Beauty>1275</Beauty><WorkToBuild>9600</WorkToBuild><Mass>2.4</Mass></statBases>
    <uiOrder>1001.25</uiOrder>
    <comps><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><legendaryOnly>true</legendaryOnly></li></comps>
    <designationCategory>Floors</designationCategory><designatorDropdown>Crimson_RugsA1</designatorDropdown>
  </ThingDef>
