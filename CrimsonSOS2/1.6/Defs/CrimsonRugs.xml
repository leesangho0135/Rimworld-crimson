    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>LowPlant</altitudeLayer>
    <passability>Standable</passability><pathCost>0</pathCost><fillPercent>0</fillPercent>
    <coversFloor>false</coversFloor><wipesPlants>false</wipesPlants><clearBuildingArea>false</clearBuildingArea>
    <rotatable>true</rotatable><defaultPlacingRot>North</defaultPlacingRot>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsFurniture</li></thingCategories>
    <designationCategory>Furniture</designationCategory>
    <designatorDropdown>Crimson_RugsA1</designatorDropdown>
    <graphicData>
      <texPath>Crimson/Decor/Rugs/RugA1</texPath>
      <graphicClass>CrimsonSOS2.CrimsonRugGraphic</graphicClass>
      <shaderType>Cutout</shaderType><drawRotated>false</drawRotated>
      <drawOffset>(0,0.01,0)</drawOffset><shadowData IsNull="True" />
