    <costList><Hyperweave>42</Hyperweave></costList><statBases><Beauty>1200</Beauty><WorkToBuild>4800</WorkToBuild><Mass>1.2</Mass></statBases>
    <uiOrder>1001</uiOrder>
      <comps><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><legendaryOnly>true</legendaryOnly></li></comps>
    <designationCategory>Floors</designationCategory>
    <designatorDropdown>Crimson_RugsA1</designatorDropdown>
