<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>Crimson_SoldierRifle</defName>
    <label>심홍 제식 자동소총</label>
    <description>병사용 중거리 3점사 에너지 자동소총. 긴 총열과 완전한 개머리판을 갖추며 심홍 광선탄으로 화상 피해를 준다. 전설급 피해·관통·명중 성능을 수치에 고정 적용했다. 품질 등급과 전용 특성은 없다.</description>
    <graphicData>
      <texPath>Crimson/Equipment/RanksV173/SoldierRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1.9,0.95)</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <statBases>
      <WorkToMake>40000</WorkToMake>
      <Mass>2.4</Mass>
      <MaxHitPoints>180</MaxHitPoints>
      <MarketValue>8400</MarketValue>
      <Flammability>0</Flammability>
      <Beauty>-3</Beauty>
      <AccuracyTouch>0.975</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>0.825</AccuracyLong>
      <RangedWeapon_Cooldown>1.1</RangedWeapon_Cooldown>
      <RangedWeapon_WarmupMultiplier>1</RangedWeapon_WarmupMultiplier>
      <RangedWeapon_DamageMultiplier>1</RangedWeapon_DamageMultiplier>
      <RangedWeapon_ArmorPenetrationMultiplier>1</RangedWeapon_ArmorPenetrationMultiplier>
      <DeteriorationRate>0.2</DeteriorationRate>
    </statBases>
    <costList>
      <Plasteel>55</Plasteel>
      <Steel>35</Steel>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
    <recipeMaker>
      <researchPrerequisite>ChargedShot</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <useIngredientsForColor>false</useIngredientsForColor>
    </recipeMaker>
    <soundInteract>Interact_SMG</soundInteract>
    <equippedAngleOffset>0</equippedAngleOffset>
    <weaponTags>
      <li>SpacerGun</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Crimson_SoldierRifleBolt</defaultProjectile>
        <warmupTime>0.4</warmupTime>
        <range>36.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>Shot_ChargeRifle</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompEquippable</compClass>
      </li>
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>Crimson_SoldierRifleBolt</defName>
    <label>심홍 자동소총 광선탄</label>
    <thingClass>CrimsonSOS2.CrimsonPulseProjectile</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <projectile>
      <damageDef>Burn</damageDef>
      <damageAmountBase>24</damageAmountBase>
      <armorPenetrationBase>0.35</armorPenetrationBase>
      <speed>180</speed>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>Crimson_HammerAxe</defName>
    <label>심홍 파쇄도끼</label>
    <description>한쪽은 절삭 도끼날, 반대쪽은 파쇄 망치인 작업·전투 겸용 도구. 주무기로 장비한 동안 채굴속도 ×1.4, 건설속도 ×1.25. 부유 작업 보조기와 함께 사용하면 각각 ×1.68, ×1.5로 적용된다. 전설급 피해·관통 수치를 고정 적용했으며 품질 등급과 결속 특성은 없다.</description>
    <graphicData>
      <texPath>Crimson/Equipment/RanksV173/HammerAxe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1.25,1.25)</drawSize>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <equippedAngleOffset>-35</equippedAngleOffset>
    <statBases>
      <WorkToMake>34000</WorkToMake>
      <Mass>1.8</Mass>
      <MaxHitPoints>240</MaxHitPoints>
      <MarketValue>2800</MarketValue>
      <Flammability>0</Flammability>
      <Beauty>-3</Beauty>
      <MeleeWeapon_DamageMultiplier>1</MeleeWeapon_DamageMultiplier>
      <MeleeWeapon_CooldownMultiplier>1</MeleeWeapon_CooldownMultiplier>
      <DeteriorationRate>0.2</DeteriorationRate>
    </statBases>
    <stuffCategories Inherit="False" />
    <costStuffCount>0</costStuffCount>
    <defaultStuff IsNull="True" />
    <costList>
      <Plasteel>40</Plasteel>
      <Steel>25</Steel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Fabrication</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <useIngredientsForColor>false</useIngredientsForColor>
    </recipeMaker>
    <tools Inherit="False">
      <li>
        <label>도끼날</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>49.5</power>
        <cooldownTime>1.2</cooldownTime>
        <armorPenetration>0.690</armorPenetration>
      </li>
      <li>
        <label>망치 타격면</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>46.2</power>
        <cooldownTime>1.2</cooldownTime>
        <armorPenetration>0.65625</armorPenetration>
      </li>
      <li>
        <label>자루</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9.9</power>
        <cooldownTime>1.2</cooldownTime>
        <armorPenetration>0.2025</armorPenetration>
      </li>
    </tools>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompEquippable</compClass>
      </li>
      <li Class="CompProperties_Styleable" />
    </comps>
    <modExtensions>
      <li Class="CrimsonSOS2.CrimsonWorkEquipmentExtension">
        <miningFactor>1.4</miningFactor>
        <constructionFactor>1.25</constructionFactor>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>