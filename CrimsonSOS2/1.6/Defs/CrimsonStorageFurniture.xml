    <comps><li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>30</basePowerConsumption><transmitsPower>false</transmitsPower></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>120</originalMaxHitPoints></li></comps>
    <uiOrder>1084</uiOrder>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
