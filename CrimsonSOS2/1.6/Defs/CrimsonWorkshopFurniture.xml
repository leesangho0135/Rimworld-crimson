<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BenchBase">
    <defName>Crimson_InductionCooker</defName>
    <label>심홍 조리대</label>
    <description>불꽃 없이 밀폐형 유도 가열판으로 식사를 준비하는 미래형 조리대입니다. 작업대 위에 선반을 얹어 식재료를 가까이 보관할 수 있습니다.</description>
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <graphicData Inherit="False"><texPath>Crimson/Decor/Revision/InductionCooker</texPath><graphicClass>CrimsonSOS2.CrimsonCardinalGraphic</graphicClass><shaderType>Cutout</shaderType><drawSize>(3,1.15)</drawSize><drawRotated>false</drawRotated><shadowData IsNull="True" /></graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <costList Inherit="False"><Steel>80</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>1260</MaxHitPoints>
      <Flammability>0</Flammability>
    <Beauty>40</Beauty><MarketValue>8206.48</MarketValue></statBases>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <uiOrder>1000</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <recipes>
      <li>CookMealSimple</li>
      <li>CookMealFine</li>
      <li>CookMealFine_Veg</li>
      <li>CookMealFine_Meat</li>
      <li>CookMealLavish</li>
      <li>CookMealLavish_Veg</li>
      <li>CookMealLavish_Meat</li>
      <li>CookMealSurvival</li>
      <li>CookMealSimpleBulk</li>
      <li>CookMealFineBulk</li>
      <li>CookMealFineBulk_Veg</li>
      <li>CookMealFineBulk_Meat</li>
      <li>CookMealLavishBulk</li>
      <li>CookMealLavishBulk_Veg</li>
      <li>CookMealLavishBulk_Meat</li>
      <li>CookMealSurvivalBulk</li>
      <li>Make_Pemmican</li>
      <li>Make_PemmicanBulk</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Make_BabyFood</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Make_BabyFoodBulk</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>350</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>3</heatPerSecond>
      </li>
    <li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>180</originalMaxHitPoints></li></comps>
    <building>
      <isMealSource>true</isMealSource>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <heatPerTickWhileWorking>0.10</heatPerTickWhileWorking>
      <workTableRoomRole>Kitchen</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <drawerType>RealtimeOnly</drawerType>
    <defaultPlacingRot>North</defaultPlacingRot>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
    <designatorDropdown IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="BenchBase">
    <defName>Crimson_MachiningBench</defName>
    <label>심홍 기계 작업대</label>
    <description>일상적인 기계 가공과 장비 분해에 쓰는 간결한 함선 작업대입니다. 작업대 위에 선반을 얹어 재료를 가까이 보관할 수 있습니다.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData Inherit="False"><texPath>Crimson/Decor/Revision/MachiningBench</texPath><graphicClass>CrimsonSOS2.CrimsonCardinalGraphic</graphicClass><shaderType>Cutout</shaderType><drawSize>(3,1.15)</drawSize><drawRotated>false</drawRotated><shadowData IsNull="True" /></graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <costList Inherit="False"><Steel>80</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
      <MaxHitPoints>1260</MaxHitPoints>
      <Flammability>0</Flammability>
      <Cleanliness>-2</Cleanliness>
    <Beauty>40</Beauty><MarketValue>8203.888</MarketValue></statBases>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <uiOrder>1001</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <recipes>
      <li>ButcherCorpseMechanoid</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>350</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(73,123,138,0)</glowColor>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Breakdownable" />
    <li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>180</originalMaxHitPoints></li></comps>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>Machining</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <drawerType>RealtimeOnly</drawerType>
    <defaultPlacingRot>North</defaultPlacingRot>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
    <designatorDropdown IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="BenchBase">
    <defName>Crimson_FabricationBench</defName>
    <label>심홍 조립 작업대</label>
    <description>소형 조립 장치와 정밀 작업면을 갖춘 간결한 함선 조립대입니다. 부품과 첨단 장비를 제작하며, 작업대 위에 선반을 얹어 재료를 가까이 보관할 수 있습니다.</description>
    <thingClass>Building_WorkTable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>2100</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Flammability>0</Flammability>
    <Beauty>40</Beauty><MarketValue>12406.48</MarketValue></statBases>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <size>(3,1)</size>
    <costList Inherit="False"><Steel>120</Steel><ComponentIndustrial>4</ComponentIndustrial></costList>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    <li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>300</originalMaxHitPoints></li></comps>
    <recipes>
      <li>Make_ComponentIndustrial</li>
      <li>Make_ComponentSpacer</li>
    </recipes>
    <graphicData>
      <texPath>Crimson/Decor/Workshops/FabricationBenchAtlas</texPath>
      <graphicClass>CrimsonSOS2.CrimsonV48AtlasGraphic</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(3.3,1.8)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
