<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Native work scanners for the three new benches; originals stay untouched. -->
  <WorkGiverDef>
    <defName>Crimson_DoBillsCook</defName>
    <label>심홍 조리대에서 요리</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Cooking</workType><priorityInType>100</priorityInType>
    <fixedBillGiverDefs><li>Crimson_InductionCooker</li></fixedBillGiverDefs>
    <verb>cook at</verb><gerund>cooking at</gerund>
    <requiredCapacities><li>Manipulation</li></requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>
  <WorkGiverDef>
    <defName>Crimson_DoBillsMachiningTable</defName>
    <label>심홍 기계 작업대에서 제작</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Smithing</workType><priorityInType>75</priorityInType>
    <fixedBillGiverDefs><li>Crimson_MachiningBench</li></fixedBillGiverDefs>
    <verb>work at</verb><gerund>working at</gerund>
    <requiredCapacities><li>Manipulation</li></requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>
  <WorkGiverDef>
    <defName>Crimson_DoBillsFabricationBench</defName>
    <label>심홍 조립 작업대에서 제작</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Smithing</workType><priorityInType>50</priorityInType>
    <fixedBillGiverDefs><li>Crimson_FabricationBench</li></fixedBillGiverDefs>
    <verb>fabricate things at</verb><gerund>fabricating things at</gerund>
    <requiredCapacities><li>Manipulation</li></requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>
</Defs>
