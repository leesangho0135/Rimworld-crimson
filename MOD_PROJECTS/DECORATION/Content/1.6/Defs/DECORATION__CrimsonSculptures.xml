<?xml version='1.0' encoding='utf-8'?>
<Defs><!-- Native SculptureBase preserves art, quality, meditation, trade and minification.
       These additions are built in place, so the sculpting-table recipe is removed. -->
  <ThingDef Name="Crimson_ConstructedSculptureBase" ParentName="SculptureBase" Abstract="True">
    <thingClass>CrimsonSOS2.CrimsonSculpture</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>200</basePowerConsumption><transmitsPower>false</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>2.5</glowRadius><glowColor>(144,24,16,0)</glowColor></li>
    </comps>
    <rotatable>false</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <recipeMaker IsNull="True" />
    <thingSetMakerTags Inherit="False" />
    <graphicData>
      <graphicClass>CrimsonSOS2.CrimsonSculptureGraphic</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawRotated>false</drawRotated>
      <shadowData IsNull="True" />
    </graphicData>
    <stuffCategories><li>Metallic</li><li>Woody</li><li>Stony</li></stuffCategories>
    <building><paintable>false</paintable></building>
    <designationCategory>Furniture</designationCategory>
    <designatorDropdown>Crimson_Sculptures</designatorDropdown>
    <uiOrder>1050</uiOrder>
  </ThingDef>
  <ThingDef ParentName="Crimson_ConstructedSculptureBase">
    <defName>Crimson_SculptureGrand</defName>
    <label>심홍 대형 조각상</label>
    <description>검은 각면과 절제된 진홍색 포인트로 구성한 조각품입니다. 건설할 때 선택된 조형 4종 가운데 하나가 무작위로 정해지며, 저장·운반·재설치 후에도 같은 외형을 유지합니다. 좌우반전 명령은 현재 조형의 방향만 바꿉니다.</description>
    <size>(3,3)</size>
    <fillPercent>0.5</fillPercent>
    <uiIconPath>Crimson/Decor/Sculptures/L03</uiIconPath>
    <graphicData>
      <texPath>Crimson/Decor/Sculptures/L03</texPath>
      <drawSize>(3.8,3.8)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>2100</MaxHitPoints>
      <Mass>28</Mass>
      <Beauty>12600</Beauty>
      <WorkToBuild>105000</WorkToBuild>
      <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">40</StyleDominance>
    <MarketValue>40340.2</MarketValue><Flammability>0</Flammability></statBases>
    <costStuffCount>0</costStuffCount>
    <modExtensions>
      <li Class="CrimsonSOS2.CrimsonSculptureVariants">
        <variants><li>L03</li><li>L04</li><li>L05</li><li>L07</li></variants>
        <variantLabels><li>공허의 합의</li><li>검은 날개의 수호자</li><li>흑일의 봉헌</li><li>문턱의 사제</li></variantLabels>
        <!-- Preserve each unmodified source PNG's aspect ratio; selected geometry is not final runtime validation. -->
        <drawSizes><li>(3.8,3.8)</li><li>(3.8,2.53333)</li><li>(3.8,3.47271)</li><li>(3.8,3.47271)</li></drawSizes>
      </li>
    </modExtensions>
    <uiOrder>1020</uiOrder>
      <stuffCategories Inherit="False" />
      <defaultStuff IsNull="True" />
      <costList Inherit="False"><WoodLog>400</WoodLog></costList>
      <comps><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>300</originalMaxHitPoints></li></comps>
    <designationCategory>Misc</designationCategory>
    <designatorDropdown>Crimson_Sculptures</designatorDropdown>
  </ThingDef>
