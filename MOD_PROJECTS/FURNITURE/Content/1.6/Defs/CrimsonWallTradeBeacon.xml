<?xml version='1.0' encoding='utf-8'?>
<Defs><ThingDef ParentName="BuildingBase">
    <defName>Crimson_WallTradeBeacon</defName>
    <label>심홍 벽걸이 무역 송신기</label>
    <description>검은 금속과 심홍색 신호부로 구성된 1×1 벽걸이 무역 송신기입니다. 궤도 무역선에 판매할 물품을 탐지합니다. 기본 송신기 반경 7.9칸의 5배인 39.5칸을 탐지하며, 벽이나 문으로 분리된 구역의 물품은 탐지하지 않습니다. 선택 및 배치 시 실제 탐지 구역을 표시합니다. 기본 송신기와 같은 40W를 소비하며, 정전되거나 스위치를 끄면 거래 탐지가 중지됩니다. 설치에는 뒤쪽을 받치는 벽이 필요합니다.</description>
    <thingClass>CrimsonSOS2.CrimsonWallTradeBeacon</thingClass>
    <graphicData>
      <texPath>Crimson/Decor/Communications/WallTradeBeacon</texPath>
      <graphicClass>CrimsonSOS2.CrimsonWallStateGraphic</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(0.94,0.46)</drawSize>
      <drawRotated>true</drawRotated>
      <addTopAltitudeBias>false</addTopAltitudeBias>
      <shadowData IsNull="True" />
      <drawOffsetNorth>(0,0,0.64)</drawOffsetNorth>
      <drawOffsetEast>(0.64,0,0)</drawOffsetEast>
      <drawOffsetSouth>(0,0,-0.64)</drawOffsetSouth>
      <drawOffsetWest>(-0.64,0,0)</drawOffsetWest>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <blockLight>false</blockLight>
    <blockWind>false</blockWind>
    <coversFloor>false</coversFloor>
    <clearBuildingArea>false</clearBuildingArea>
    <canOverlapZones>true</canOverlapZones>
    <stuffCategories Inherit="False" />
    <costStuffCount>0</costStuffCount>
    <defaultStuff IsNull="True" />
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <statBases>
      <MaxHitPoints>525</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>5</Mass>
      <Beauty>5</Beauty>
    </statBases>
    <costList><Steel>40</Steel><ComponentIndustrial>1</ComponentIndustrial></costList>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
      <paintable>false</paintable>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>40</basePowerConsumption></li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>75</originalMaxHitPoints><goldReference>true</goldReference></li>
    </comps>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2101</uiOrder>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <placeWorkers>
      <li>CrimsonSOS2.CrimsonFurnitureWallPlaceWorker</li>
      <li>CrimsonSOS2.CrimsonTradeBeaconRadiusPlaceWorker</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites><li>MicroelectronicsBasics</li></researchPrerequisites>
  </ThingDef>
</Defs>