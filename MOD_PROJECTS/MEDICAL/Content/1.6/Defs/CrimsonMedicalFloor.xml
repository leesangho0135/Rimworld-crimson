<?xml version='1.0' encoding='utf-8'?>
<Defs><TerrainDef ParentName="FloorBase">
    <defName>Crimson_MedicalFloor</defName>
    <label>심홍 의료 바닥</label>
    <description>함선 병실과 수술실을 위한 검은 금속 항균 바닥입니다. 밀폐된 패널 이음부와 절제된 심홍색 표시로 마감했습니다. 바닥 한 칸의 청결도는 +1.5로 기본 항균 타일(+0.6)의 2.5배이며, 미관은 25입니다. 시공 비용과 청소 속도, 연구 조건은 기본 항균 타일과 같습니다. 작위의 고급 바닥 요구 조건에 인정됩니다.</description>
    <renderPrecedence>244</renderPrecedence>
    <texturePath>Crimson/Decor/Floors/MedicalFloor</texturePath>
    <color>(1,1,1)</color>
    <pollutionTintColor>(0.95,0.95,0.93,1)</pollutionTintColor>
    <isPaintable>true</isPaintable>
    <statBases>
      <WorkToBuild>1600</WorkToBuild>
      <Cleanliness>1.5</Cleanliness>
      <CleaningTimeFactor>0.6</CleaningTimeFactor>
      <Beauty>25</Beauty>
    </statBases>
    <costList><Steel>3</Steel><Silver>12</Silver></costList>
    <constructEffect>ConstructMetal</constructEffect>
    <designationHotKey IsNull="True" />
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <researchPrerequisites><li>SterileMaterials</li></researchPrerequisites>
    <tags><li>FineFloor</li></tags>
    <uiOrder>2051</uiOrder>
  </TerrainDef>
</Defs>