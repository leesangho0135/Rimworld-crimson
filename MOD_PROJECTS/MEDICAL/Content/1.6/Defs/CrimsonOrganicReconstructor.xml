<?xml version='1.0' encoding='utf-8'?>
<Defs><ThingDef ParentName="BuildingBase">
    <defName>Crimson_OrganicReconstructor</defName>
    <label>심홍 유기물 재구성로</label>
    <description>시체를 밀폐된 플라즈마 처리실에서 분해하고 유기물을 자원으로 재구성하는 3×3 함선용 설비입니다. 운반자는 시체를 투입한 뒤 즉시 다른 작업으로 복귀합니다. 1구를 자동 처리하며 추가 10구를 투입 순서대로 보관합니다. 정전 중에는 진행을 멈추고 전원 복구 후 이어서 처리합니다. 투입된 시체는 작업 목록을 변경해도 처리하며, 목록의 필터와 수량은 새 투입에 적용됩니다. 사람 크기 시체 1구를 기준으로 화학연료 5개와 강철 10개를 회수하며, 다른 유기물 시체는 몸집에 비례합니다. 극소형 시체는 최소 화학연료 1개와 강철 2개를 회수합니다. 메카노이드 시체는 처리하지 않습니다. 작업 방향만 회전하며 이미지는 항상 같은 탑뷰로 표시되고 전원 공급 시 처리실이 심홍색으로 빛납니다.</description>
    <thingClass>CrimsonSOS2.CrimsonOrganicReconstructorQueue</thingClass>
    <graphicData>
      <texPath>Crimson/Decor/Workshops/OrganicReconstructorTopDown</texPath>
      <graphicClass>CrimsonSOS2.CrimsonOrganicReconstructorGraphic</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(2.96,2.96)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    <stuffCategories Inherit="False">
    </stuffCategories>
    <costStuffCount>0</costStuffCount>
    <costList Inherit="False">
      <Steel>170</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>4500</WorkToBuild>
      <MaxHitPoints>2100</MaxHitPoints>
      <Cleanliness>0</Cleanliness>
      <Beauty>2</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <size>(3,3)</size>
    <designationCategory>Production</designationCategory>
    <fillPercent>1</fillPercent>
    <passability>Impassable</passability>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <interactionCellIcon>DiningChair</interactionCellIcon>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <recipes>
      <li>Crimson_ReconstituteOrganicMatter</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(245,24,38,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>12</heatPerSecond>
      </li>
      <li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture">
        <originalMaxHitPoints>300</originalMaxHitPoints>
        <goldReference>true</goldReference>
      </li>
    </comps>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <heatPerTickWhileWorking>0.32</heatPerTickWhileWorking>
      <forceShowRoomStats>true</forceShowRoomStats>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <paintable>false</paintable>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <designationHotKey IsNull="True">
    </designationHotKey>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <techLevel>Industrial</techLevel>
    <rotatable>true</rotatable>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <defaultStuff IsNull="True">
    </defaultStuff>
    <uiOrder>1004</uiOrder>
    <defaultPlacingRot>North</defaultPlacingRot>
  </ThingDef>
  <RecipeDef>
    <defName>Crimson_ReconstituteOrganicMatter</defName>
    <label>유기물 재구성</label>
    <description>유기물 시체 1구를 플라즈마로 분해하여 몸집에 비례하는 화학연료와 강철을 회수합니다. 사람 크기 시체 기준 화학연료 5개, 강철 10개입니다. 우라늄은 생산하지 않습니다.</description>
    <jobString>유기물을 재구성하는 중.</jobString>
    <workAmount>180</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <soundWorking>Recipe_Smelt</soundWorking>
    <autoStripCorpses>false</autoStripCorpses>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Corpses</li>
      </categories>
      <disallowedCategories>
        <li>CorpsesMechanoid</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">CorpsesDrone</li>
      </disallowedCategories>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>Corpses</li>
      </categories>
      <specialFiltersToAllow>
        <li>AllowCorpsesColonist</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">AllowCorpsesSlave</li>
        <li>AllowCorpsesStranger</li>
      </specialFiltersToAllow>
    </defaultIngredientFilter>
    <products>
      <Chemfuel>5</Chemfuel>
      <Steel>10</Steel>
    </products>
    <uiIconThing>Chemfuel</uiIconThing>
  </RecipeDef>
  <WorkGiverDef>
    <defName>Crimson_DoBillsOrganicReconstructor</defName>
    <label>유기물 재구성 작업</label>
    <giverClass>CrimsonSOS2.WorkGiver_CrimsonOrganicLoad</giverClass>
    <workType>Hauling</workType>
    <priorityInType>40</priorityInType>
    <fixedBillGiverDefs>
      <li>Crimson_OrganicReconstructor</li>
    </fixedBillGiverDefs>
    <verb>재구성</verb>
    <gerund>재구성 중</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>
  <JobDef>
    <defName>Crimson_LoadOrganicReconstructor</defName>
    <driverClass>CrimsonSOS2.JobDriver_CrimsonOrganicLoad</driverClass>
    <reportString>TargetB를 유기물 재구성로에 투입하는 중.</reportString>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
  </JobDef>
</Defs>