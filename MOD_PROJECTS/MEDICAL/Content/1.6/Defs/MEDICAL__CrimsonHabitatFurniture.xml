<?xml version='1.0' encoding='utf-8'?>
<Defs><ThingDef ParentName="Crimson_HabitatBedBase">
    <defName>Crimson_MedicalBed</defName>
    <label>심홍 의료 침대</label>
    <description>함선용 의료침대입니다. 고정 전설 규격의 수술 성공 계수는 환경 보정 전 260%, 면역 획득 속도는 200%이며 자연 치유량은 하루 6입니다. 전원 공급 시 편안함이 50% 향상됩니다. 생체모니터·수액대·협탁·옷장을 연결할 수 있으며 실제 수술 결과에는 의료 기술·약품·청결도·조명 등 기존 조건이 적용됩니다. 소비전력은 250W이며 정전 중에도 병상으로 사용할 수 있습니다.</description>
    <graphicData><texPath>Crimson/Decor/Habitat/MedicalBedStates</texPath><drawSize>(1,2)</drawSize></graphicData>
    <statBases>
      <MaxHitPoints>1400</MaxHitPoints><WorkToBuild>2800</WorkToBuild>
      <BedRestEffectiveness>1</BedRestEffectiveness><Comfort>1.6</Comfort>
      <SurgerySuccessChanceFactor>2</SurgerySuccessChanceFactor>
      <MedicalTendQualityOffset>0.1</MedicalTendQualityOffset>
      <ImmunityGainSpeedFactor>2</ImmunityGainSpeedFactor>
    <Beauty>120</Beauty><MarketValue>12509.0723</MarketValue><Flammability>0</Flammability></statBases>
    <building><bed_defaultMedical>true</bed_defaultMedical><buildingSizeCategory>Small</buildingSizeCategory></building>
    <costList Inherit="False"><Steel>100</Steel><Plasteel>20</Plasteel><ComponentIndustrial>5</ComponentIndustrial></costList>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>250</basePowerConsumption><transmitsPower>false</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>1.6</glowRadius><glowColor>(120,20,16,0)</glowColor></li>
      <li Class="CompProperties_AffectedByFacilities"><linkableFacilities><li>Crimson_BedsideTable</li><li>Crimson_Wardrobe</li><li>Crimson_VitalsMonitor</li><li>Crimson_IVStand</li></linkableFacilities></li>
      <li Class="CrimsonSOS2.CompProperties_CrimsonPoweredComfort" />
    <li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><facilityComfortIsFinal>true</facilityComfortIsFinal><originalMaxHitPoints>200</originalMaxHitPoints></li></comps>
    <researchPrerequisites><li>HospitalBed</li></researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <uiOrder>1142</uiOrder>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
    <designationCategory>Furniture</designationCategory>
    <designatorDropdown IsNull="True" />
  </ThingDef>

  <ThingDef ParentName="Crimson_HabitatFacilityBase">
    <defName>Crimson_VitalsMonitor</defName>
    <label>심홍 생체 모니터</label>
    <description>함선 벽에 부착하는 3×1 의료 모니터입니다. 하단 받침대 없이 화면 3개만 벽 위에 배치하여 아래쪽 테이블과 함께 사용할 수 있습니다. 8칸 범위의 연결된 심홍 의료침대 1개에 전원이 공급되는 동안 편안함 +0.3, 치료 품질 보정 +4%p, 면역 획득 속도 +50%p, 수술 성공 계수 +40%p를 제공합니다. 같은 종류의 효과는 중첩되지 않습니다. 소비전력은 1500W입니다.</description>
    <size>(3,1)</size>
    <graphicData Inherit="False"><texPath>Crimson/Decor/Revision/VitalsMonitorWall</texPath><graphicClass>CrimsonSOS2.CrimsonCardinalGraphic</graphicClass><shaderType>Cutout</shaderType><drawSize>(3,0.8)</drawSize><drawOffsetNorth>(0,0,0.85)</drawOffsetNorth><drawOffsetEast>(0.85,0,0)</drawOffsetEast><drawOffsetSouth>(0,0,-0.85)</drawOffsetSouth><drawOffsetWest>(-0.85,0,0)</drawOffsetWest><drawRotated>false</drawRotated><shadowData IsNull="True" /></graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability><pathCost>0</pathCost><fillPercent>0.15</fillPercent><blockLight>false</blockLight><clearBuildingArea>false</clearBuildingArea>
    <building><isEdifice>false</isEdifice><isAttachment>true</isAttachment></building>
    <placeWorkers Inherit="False"><li>CrimsonSOS2.CrimsonFurnitureWallPlaceWorker</li><li>PlaceWorker_ShowFacilitiesConnections</li></placeWorkers>
    <statBases><MaxHitPoints>1260</MaxHitPoints><WorkToBuild>6000</WorkToBuild><Mass>50</Mass><Beauty>60</Beauty><MarketValue>12519.44</MarketValue><Flammability>0</Flammability></statBases>
    <costList Inherit="False"><Steel>90</Steel><Plasteel>30</Plasteel><ComponentIndustrial>5</ComponentIndustrial></costList>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>1500</basePowerConsumption><transmitsPower>false</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>1.6</glowRadius><glowColor>(120,20,16,0)</glowColor></li>
      <li Class="CrimsonSOS2.CompProperties_CrimsonVitalsFacility"><statOffsets><Comfort>0.3</Comfort><MedicalTendQualityOffset>0.04</MedicalTendQualityOffset><ImmunityGainSpeedFactor>0.5</ImmunityGainSpeedFactor><SurgerySuccessChanceFactor>0.4</SurgerySuccessChanceFactor></statOffsets><maxSimultaneous>1</maxSimultaneous><maxDistance>8</maxDistance></li>
    <li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>180</originalMaxHitPoints></li></comps>
    <researchPrerequisites><li>VitalsMonitor</li></researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <uiOrder>1040</uiOrder>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
    <designationCategory>Misc</designationCategory>
    <designatorDropdown>Crimson_MedicalSupport</designatorDropdown>
  <defaultPlacingRot>North</defaultPlacingRot></ThingDef>

  <ThingDef ParentName="StorageShelfBase">
    <defName>Crimson_MedicineCabinet</defName>
    <label>심홍 약품장</label>
    <designationHotKey IsNull="True" />
    <description>약품을 구분해 보관하는 3×1 함선용 약품장입니다. 세 칸에 약품을 보관하며 보관물은 열화로부터 보호됩니다. 표시등과 약한 주변 조명에 50W를 사용합니다.</description>
    <designationCategory>Furniture</designationCategory>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <size>(3,1)</size>
    <graphicData Inherit="False"><texPath>Crimson/Decor/Revision/MedicineCabinet</texPath><graphicClass>CrimsonSOS2.CrimsonCardinalGraphic</graphicClass><shaderType>Cutout</shaderType><drawSize>(3,1.25)</drawSize><drawRotated>false</drawRotated><shadowData IsNull="True" /></graphicData>
    <statBases><MaxHitPoints>980</MaxHitPoints><WorkToBuild>1400</WorkToBuild><Mass>20</Mass><Beauty>40</Beauty><MarketValue>6104.536</MarketValue><Flammability>0</Flammability></statBases>
    <stuffCategories Inherit="False" />
    <costList Inherit="False"><Steel>60</Steel><ComponentIndustrial>1</ComponentIndustrial></costList>
    <building>
      <storageGroupTag>Crimson_MedicineCabinet</storageGroupTag>
      <fixedStorageSettings Inherit="False"><filter><categories><li>Medicine</li></categories></filter></fixedStorageSettings>
      <defaultStorageSettings Inherit="False"><priority>Preferred</priority><filter><categories><li>Medicine</li></categories></filter></defaultStorageSettings>
    </building>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>50</basePowerConsumption><transmitsPower>false</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>1.6</glowRadius><glowColor>(120,20,16,0)</glowColor></li>
    <li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>140</originalMaxHitPoints></li></comps>
    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
    <uiOrder>1087</uiOrder>
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
    <designatorDropdown>Crimson_StorageFurniture</designatorDropdown>
  <defaultPlacingRot>North</defaultPlacingRot></ThingDef>

  <ThingDef ParentName="Crimson_HabitatFacilityBase">
    <defName>Crimson_IVStand</defName>
    <label>심홍 수액대</label>
    <description>인접한 심홍 의료침대에 연결하는 수액대입니다. 전원이 공급되면 면역 획득 속도 +50%p를 제공합니다. 같은 침대에는 같은 종류의 수액대 효과가 한 번만 적용됩니다. 소비전력은 50W입니다.</description>
    <rotatable>false</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <graphicData><texPath>Crimson/Decor/Habitat/IVStandStates</texPath><drawRotated>false</drawRotated><drawSize>(0.9,1.75)</drawSize><drawOffset>(0,0,0.38)</drawOffset></graphicData>
    <statBases><MaxHitPoints>560</MaxHitPoints><WorkToBuild>1000</WorkToBuild><Mass>5</Mass><Beauty>40</Beauty><MarketValue>3039.24</MarketValue><Flammability>0</Flammability></statBases>
    <fillPercent>0.2</fillPercent>
    <costList Inherit="False"><Steel>30</Steel><MedicineIndustrial>2</MedicineIndustrial></costList>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>50</basePowerConsumption><transmitsPower>false</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>1.6</glowRadius><glowColor>(120,20,16,0)</glowColor></li>
      <li Class="CompProperties_Facility"><statOffsets><ImmunityGainSpeedFactor>0.5</ImmunityGainSpeedFactor></statOffsets><maxSimultaneous>1</maxSimultaneous><mustBePlacedAdjacent>true</mustBePlacedAdjacent></li>
    <li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>80</originalMaxHitPoints></li><li Class="CrimsonSOS2.CompProperties_CrimsonMirror"><refrigeratorScreen>false</refrigeratorScreen></li></comps>
    <researchPrerequisites><li>HospitalBed</li></researchPrerequisites>
    <uiOrder>1041</uiOrder>
      <stuffCategories Inherit="False" />
      <costStuffCount>0</costStuffCount>
      <defaultStuff IsNull="True" />
    <designationCategory>Misc</designationCategory>
    <designatorDropdown>Crimson_MedicalSupport</designatorDropdown>
  </ThingDef>
</Defs>