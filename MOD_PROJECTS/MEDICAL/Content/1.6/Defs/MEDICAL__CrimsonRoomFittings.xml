<?xml version='1.0' encoding='utf-8'?>
<Defs><ThingDef ParentName="BookcaseBase">
    <defName>Crimson_MedicalSupplyCabinet</defName>
    <label>심홍 책장</label>
    <thingClass>CrimsonSOS2.CrimsonBookshelf</thingClass>
    <description>검은 금속 외장과 심홍색 장식을 갖춘 1×1 책장입니다. 3단 선반에 단당 4권씩, 실제 책을 최대 12권 보관합니다. 책을 넣고 꺼내면 정면의 책등 표시가 수납 상태에 맞춰 바뀝니다. 보관한 책은 열화로부터 보호되며 기본 책장과 같은 독서·연구 보조 기능을 제공합니다. 표시등과 약한 주변 조명에 50W를 사용하며 정전 중에도 책을 보관할 수 있습니다.</description>
    <designationCategory>Furniture</designationCategory>
    <designatorDropdown IsNull="True" />
    <designationHotKey IsNull="True" />
    <drawerType>RealtimeOnly</drawerType><tickerType>Normal</tickerType>
    <size>(1,1)</size><rotatable>true</rotatable>
    <stuffCategories Inherit="False" /><costStuffCount>0</costStuffCount>
    <graphicData Inherit="False"><texPath>Crimson/Decor/Revision/Bookcase</texPath><graphicClass>CrimsonSOS2.CrimsonCardinalGraphic</graphicClass><shaderType>Cutout</shaderType><drawSize>(1,1.52)</drawSize><drawRotated>false</drawRotated><shadowData IsNull="True" /></graphicData>
    <statBases><MaxHitPoints>980</MaxHitPoints><WorkToBuild>1000</WorkToBuild><Mass>12</Mass><Beauty>60</Beauty><Flammability>0</Flammability><MarketValue>3103.24</MarketValue></statBases>
    <costList Inherit="False"><Steel>30</Steel><ComponentIndustrial>1</ComponentIndustrial></costList>
    <building>
      <storageGroupTag>Crimson_Bookshelf</storageGroupTag><paintable>false</paintable>
      <maxItemsInCell>12</maxItemsInCell>
      <fixedStorageSettings Inherit="False"><filter><categories><li>Books</li></categories></filter></fixedStorageSettings>
      <defaultStorageSettings Inherit="False"><priority>Preferred</priority><filter><categories><li>Books</li></categories></filter></defaultStorageSettings>
    </building>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>50</basePowerConsumption><transmitsPower>false</transmitsPower></li>
      <li Class="CompProperties_Glower"><glowRadius>1.6</glowRadius><glowColor>(120,20,16,0)</glowColor></li>
    <li><compClass>CompQuality</compClass></li><li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture"><originalMaxHitPoints>140</originalMaxHitPoints></li></comps>
    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
    <uiOrder>1143</uiOrder>
      <defaultStuff IsNull="True" />
  <defaultPlacingRot>North</defaultPlacingRot></ThingDef>

</Defs>