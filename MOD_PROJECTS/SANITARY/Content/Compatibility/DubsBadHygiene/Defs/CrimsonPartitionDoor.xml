    <passability>Standable</passability><leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><tickerType>Normal</tickerType><rotatable>false</rotatable><staticSunShadowHeight>1</staticSunShadowHeight><blockLight>false</blockLight><drawerType>RealtimeOnly</drawerType><altitudeLayer>DoorMoveable</altitudeLayer>
    <building><soundDoorOpenManual>StallDoor</soundDoorOpenManual><blueprintGraphicData><texPath>DBH/Things/Building/Door_Blueprint</texPath></blueprintGraphicData><blueprintClass>Blueprint_Door</blueprintClass><isEdifice>true</isEdifice><isInert>true</isInert><canPlaceOverWall>true</canPlaceOverWall></building>
