<?xml version='1.0' encoding='utf-8'?>
<Defs><ThingDef ParentName="BuildingBase">
    <defName>Crimson_ObservationWindow</defName>
    <label>심홍 함선 관측창</label>
    <description>이중 밀폐 프레임과 어두운 청회색 유리를 갖춘 함선용 벽걸이 장식창입니다. 연속된 세 칸 벽의 안쪽 면에 부착하며, 기존 벽의 밀폐와 내구 기능을 유지합니다. 유리에는 희미한 별빛과 반사가 표현되어 있습니다. 실제 벽 너머의 풍경을 보여주지는 않습니다. 전력은 필요하지 않습니다.</description>
    <thingClass>Building</thingClass>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <graphicData>
      <texPath>Crimson/Decor/ObservationWindow/W04</texPath>
      <graphicClass>CrimsonSOS2.CrimsonFurnitureGraphic</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(3.1785366,1.0595122)</drawSize>
      <drawOffsetNorth>(0,0,0.6617073)</drawOffsetNorth>
      <drawOffsetEast>(0.6617073,0,0)</drawOffsetEast>
      <drawOffsetSouth>(0,0,-0.6617073)</drawOffsetSouth>
      <drawOffsetWest>(-0.6617073,0,0)</drawOffsetWest>
      <drawRotated>true</drawRotated>
      <addTopAltitudeBias>false</addTopAltitudeBias>
      <shadowData IsNull="True" />
    </graphicData>
    <uiIconPath>Crimson/Decor/ObservationWindow/W04</uiIconPath>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <blockLight>false</blockLight>
    <blockWind>false</blockWind>
    <coversFloor>false</coversFloor>
    <clearBuildingArea>false</clearBuildingArea>
    <castEdgeShadows>false</castEdgeShadows>
    <tickerType>Never</tickerType>
    <statBases>
      <MaxHitPoints>1400</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Beauty>8</Beauty>
      <Mass>20</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <stuffCategories Inherit="False" />
    <costStuffCount>0</costStuffCount>
    <defaultStuff IsNull="True" />
    <costList>
      <Steel>30</Steel>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
      <isInert>true</isInert>
      <canBuildNonEdificesUnder>true</canBuildNonEdificesUnder>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <placeWorkers>
      <li>CrimsonSOS2.CrimsonFurnitureWallPlaceWorker</li>
    </placeWorkers>
    <comps>
      <!-- The established fixed-furniture loader bakes Legendary values, then removes CompQuality. -->
      <li><compClass>CompQuality</compClass></li>
      <li Class="CrimsonSOS2.CompProperties_CrimsonFixedFurniture">
        <originalMaxHitPoints>200</originalMaxHitPoints>
        <goldReference>true</goldReference>
      </li>
    </comps>
    <!-- Legacy save compatibility only. New construction uses structural hull windows. -->
    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <uiOrder>991</uiOrder>
  </ThingDef>
</Defs>