    </graphicData>
    <statBases>
      <MaxHitPoints>10000</MaxHitPoints>
      <WorkToBuild>150000</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>2000</Mass>
    </statBases>
    <size>(5,5)</size>
    <researchPrerequisites>
      <li>ShuttleDropship</li>
    </researchPrerequisites>
