  <ThingDef ParentName="LightMechanoid" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>Crimson_ShipRobotOmni</defName>
    <label>심홍 다목적 작업로봇</label>
    <description>목격자가 통제하는 외계 부유 작업로봇. 기술 수준 20, 이동속도 8, 전체 작업속도 200%로 함선의 작업을 수행한다. 배터리를 사용하며 특이점 복원소에서 충전과 자가 정비를 받는다. 파괴되어도 남은 기체를 복원소로 회수하면 다시 가동할 수 있다. 메카나이터·대역폭·폐기물은 요구하지 않는다.</description>
    <!-- CarryingCapacity 250 / inherited BodySize 0.7; healthy final hauling capacity is 250. -->
    <statBases>
      <MoveSpeed>8</MoveSpeed>
      <WorkSpeedGlobal>2</WorkSpeedGlobal>
      <CarryingCapacity>357.142857</CarryingCapacity>
      <BandwidthCost>0</BandwidthCost>
      <MechEnergyLossPerHP>0</MechEnergyLossPerHP>
      <WastepacksPerRecharge>0</WastepacksPerRecharge>
    </statBases>
    <race>
      <thinkTreeMain>Crimson_ShipRobotWork</thinkTreeMain>
      <thinkTreeConstant>Crimson_ShipRobotConstant</thinkTreeConstant>
      <mechFixedSkillLevel>20</mechFixedSkillLevel>
      <mechEnabledWorkTypes Inherit="False">
        <li>Firefighter</li>
        <li>Doctor</li>
        <li>Cooking</li>
        <li>Construction</li>
        <li>Growing</li>
        <li>Mining</li>
        <li>PlantCutting</li>
        <li>Smithing</li>
        <li>Tailoring</li>
        <li>Art</li>
        <li>Crafting</li>
        <li>Hauling</li>
        <li>Cleaning</li>
        <li>Research</li>
      </mechEnabledWorkTypes>
      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>
    <comps Inherit="False">
      <li Class="CrimsonSOS2.CompProperties_CrimsonShipRobot">
        <role>Omni</role>
      </li>
      <li Class="CompProperties_MechRepairable" />
    </comps>
  </ThingDef>
