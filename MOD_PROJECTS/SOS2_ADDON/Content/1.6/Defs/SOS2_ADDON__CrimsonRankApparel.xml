<?xml version='1.0' encoding='utf-8'?>
<Defs><ThingDef ParentName="ApparelBase">
    <defName>Crimson_AssistDrones</defName>
    <label>심홍 부유 작업 보조기</label>
    <description>착용자의 어깨 뒤에 안정적으로 떠 있는 심홍빛 보조 드론 두 기. 몸에 고정되는 외골격 대신 하중과 작업 동작을 보조한다. 외피 슬롯에 착용하는 동안 운반량 ×2, 일반 작업속도 ×1.2. 공격·이동속도 보너스는 없다. 품질 등급 없이 전설급 능력치가 고정되어 있다.</description>
    <thingClass>Apparel</thingClass>
    <techLevel>Spacer</techLevel>
    <tickerType>Normal</tickerType>
    <generateCommonality>0</generateCommonality>
    <uiIconScale>1</uiIconScale>
    <graphicData Inherit="False">
      <texPath>Crimson/Equipment/RanksV173/AssistDrones</texPath>
      <graphicClass>CrimsonSOS2.CrimsonWardenGroundGraphic</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
    <statBases Inherit="False">
      <ArmorRating_Sharp>.36</ArmorRating_Sharp>
      <ArmorRating_Blunt>.72</ArmorRating_Blunt>
      <ArmorRating_Heat>.48</ArmorRating_Heat>
      <Insulation_Cold>0</Insulation_Cold>
      <Insulation_Heat>0</Insulation_Heat>
      <Beauty>6</Beauty>
      <MarketValue>3400</MarketValue>
      <Mass>.2</Mass>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0</Flammability>
      <EquipDelay>2</EquipDelay>
      <WorkToMake>50000</WorkToMake>
      <DeteriorationRate>0.2</DeteriorationRate>
    </statBases>
    <equippedStatOffsets Inherit="False" />
    <costList Inherit="False">
      <Plasteel>50</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
    <recipeMaker Inherit="False">
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>Fabrication</researchPrerequisite>
      <useIngredientsForColor>false</useIngredientsForColor>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <thingCategories Inherit="False">
      <li>ApparelArmor</li>
    </thingCategories>
    <apparel Inherit="False">
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Hands</li>
        <li>Feet</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>Crimson/Equipment/RanksV173/AssistDrones</wornGraphicPath>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <tags>
        <li>Spacer</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
        <li>Spacefarer</li>
      </defaultOutfitTags>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <parentTagDef>ApparelBody</parentTagDef>
    </apparel>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <colorGenerator Class="ColorGenerator_Single" Inherit="False">
      <color>(1,1,1,1)</color>
    </colorGenerator>
    <tradeTags Inherit="False">
      <li>HiTechArmor</li>
    </tradeTags>
    <thingSetMakerTags Inherit="False" />
    <modExtensions>
      <li Class="CrimsonSOS2.CrimsonWorkEquipmentExtension">
        <carryFactor>2</carryFactor>
        <workFactor>1.2</workFactor>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>